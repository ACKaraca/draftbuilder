# Messages owned by the DraftBuilder application: panel titles, the file type and the window
# title. Identifiers are registered in apps/draftbuilder/src/lib.rs.

draftbuilder-file-draftb = DraftBuilder working document
draftbuilder-file-dxf = DXF drawing
draftbuilder-panel-viewport = Viewport
draftbuilder-panel-properties = Properties
draftbuilder-panel-outliner = Outliner
draftbuilder-panel-command-line = Command line
draftbuilder-title = DraftBuilder

# Dynamic input field labels of the drawing interaction (apps/draftbuilder/src/interaction.rs).
draftbuilder-dynamic-distance = Distance
draftbuilder-dynamic-angle = Angle
draftbuilder-dynamic-x = X
draftbuilder-dynamic-y = Y
draftbuilder-dynamic-x-size = X size
draftbuilder-dynamic-y-size = Y size

# History lines of the drawing interaction: a command that ran, a cancelled one, and undo and redo steps.
draftbuilder-history-ran = Ran: { $command }
draftbuilder-history-cancelled = Cancelled: { $command }
draftbuilder-history-failed = { $command }: nothing could be changed at that point
draftbuilder-history-undo = Undo
draftbuilder-history-redo = Redo
draftbuilder-history-restored = Restored { $count } erased objects

# The toolbar strip and the status bar of the window (apps/draftbuilder/src/chrome.rs).
draftbuilder-tool-line = Line
draftbuilder-tool-polyline = Polyline
draftbuilder-tool-circle = Circle
draftbuilder-tool-arc = Arc
draftbuilder-tool-rectangle = Rectangle
draftbuilder-tool-move = Move
draftbuilder-tool-copy = Copy
draftbuilder-tool-rotate = Rotate
draftbuilder-tool-scale = Scale
draftbuilder-tool-trim = Trim
draftbuilder-tool-extend = Extend
draftbuilder-tool-offset = Offset
draftbuilder-tool-fillet = Fillet
draftbuilder-tool-erase = Erase
draftbuilder-tool-undo = Undo
draftbuilder-tool-redo = Redo
draftbuilder-tool-zoom-extents = Zoom Extents
draftbuilder-tool-layer-hint = Current layer
draftbuilder-status-grid = Grid
draftbuilder-status-grid-hint = Shows or hides the grid
draftbuilder-status-snap = Snap
draftbuilder-status-snap-hint = Snaps the pointer to the snap spacing
draftbuilder-status-ortho = Ortho
draftbuilder-status-ortho-hint = Limits the pointer to horizontal and vertical directions
draftbuilder-status-polar = Polar
draftbuilder-status-polar-hint = Aligns the pointer to polar angles
draftbuilder-status-osnap = Object Snap
draftbuilder-status-osnap-hint = Snaps the pointer to points of existing objects
