# Messages of the errors, commands and progress of draftbuilder-commands. Identifiers are
# registered in crates/draftbuilder-commands/src/error.rs and its command modules.

db-cmd-drawing-not-empty = The document already holds a drawing; open the file into a new document.
db-cmd-no-model-space = The document has no model space.
db-cmd-format-unknown = The file name must end in .dwg or .dxf.
db-cmd-format-mismatch = This command reads DXF files only; use the open command for a DWG file.
db-cmd-format-unsupported = DWG files cannot be written yet; save the drawing as DXF.
db-cmd-target-not-file = The save target exists and is not a regular file; choose another name.
db-cmd-progress-open = Opening the drawing
db-cmd-progress-save = Saving the drawing
db-cmd-open-label = Open DXF drawing
db-cmd-open-description = Reads a DXF file into the document as a drawing with its handles and fingerprint, in one undoable step.
db-cmd-open-drawing-label = Open drawing
db-cmd-open-drawing-description = Reads a DWG or DXF file into the document as a drawing with its handles and fingerprint, in one undoable step.
db-cmd-save-label = Save DXF drawing
db-cmd-save-description = Writes the drawing to a DXF file with the handles and fingerprint it was opened with.
db-cmd-save-drawing-label = Save drawing
db-cmd-save-drawing-description = Writes the drawing to a DXF file, through a temporary file that replaces the target only when it is complete.
db-cmd-new-label = New drawing
db-cmd-new-description = Creates an empty drawing from a unit system or from a template drawing, in one undoable step.
db-cmd-audit-label = Audit drawing
db-cmd-audit-description = Checks the owners, handle bindings and geometry of the drawing and reports each finding; repairs nothing.
db-cmd-purge-label = Purge drawing
db-cmd-purge-description = Removes unused layers, linetypes, blocks, styles and zero-length lines, in one undoable step.
db-cmd-selection-invalid = The selection geometry or filter cannot be used; the reason is given in the error details.
db-cmd-limit-exceeded = The selection or edit would take more objects than the command allows.
db-cmd-layer-unknown = No layer has that name.
db-cmd-linetype-unknown = No linetype has that name.
db-cmd-name-invalid = A layer name must be 1 to 255 characters and must not contain < > / \ " : ; ? * | = or a control character.
db-cmd-value-invalid = A property value is outside its allowed range.
db-cmd-nothing-to-change = The command names no property to change.
db-cmd-select-window-label = Select window
db-cmd-select-window-description = Selects the objects that lie entirely inside a rectangle, with the selection mode.
db-cmd-select-crossing-label = Select crossing
db-cmd-select-crossing-description = Selects the objects that have a part inside a rectangle or cross its boundary.
db-cmd-select-window-polygon-label = Select window polygon
db-cmd-select-window-polygon-description = Selects the objects that lie entirely inside a closed polygon.
db-cmd-select-crossing-polygon-label = Select crossing polygon
db-cmd-select-crossing-polygon-description = Selects the objects that have a part inside a closed polygon or cross its boundary.
db-cmd-select-fence-label = Select fence
db-cmd-select-fence-description = Selects the objects that an open polyline crosses.
db-cmd-select-all-label = Select all
db-cmd-select-all-description = Selects every object of the model space that the layer and visibility rules allow.
db-cmd-select-last-label = Select last
db-cmd-select-last-description = Selects the topmost object of the model space that the layer and visibility rules allow.
db-cmd-select-previous-label = Select previous
db-cmd-select-previous-description = Selects the objects of the previous selection set that still exist.
db-cmd-select-filter-label = Select by filter
db-cmd-select-filter-description = Selects the objects that satisfy a filter of property tests combined with AND, OR, XOR and NOT.
db-cmd-select-similar-label = Select similar
db-cmd-select-similar-description = Selects the objects that share the chosen properties with the given objects.
db-cmd-layer-create-label = Create layer
db-cmd-layer-create-description = Creates a layer with its name and the chosen properties, in one undoable step.
db-cmd-layer-modify-label = Modify layers
db-cmd-layer-modify-description = Sets the on, frozen, locked, plot, color, linetype, lineweight, transparency and description of layers, in one undoable step.
db-cmd-layer-change-label = Change layer of objects
db-cmd-layer-change-description = Moves the chosen objects to the named layer, in one undoable step.
db-cmd-layer-match-label = Match layer of objects
db-cmd-layer-match-description = Moves the chosen objects to the layer of a source object, in one undoable step.
db-cmd-layer-on-label = Turn layers on
db-cmd-layer-on-description = Turns on the layers of the chosen objects, in one undoable step.
db-cmd-layer-off-label = Turn layers off
db-cmd-layer-off-description = Turns off the layers of the chosen objects, in one undoable step.
db-cmd-layer-freeze-label = Freeze layers
db-cmd-layer-freeze-description = Freezes the layers of the chosen objects, in one undoable step.
db-cmd-layer-thaw-label = Thaw layers
db-cmd-layer-thaw-description = Thaws the layers of the chosen objects, in one undoable step.
db-cmd-layer-lock-label = Lock layers
db-cmd-layer-lock-description = Locks the layers of the chosen objects, in one undoable step.
db-cmd-layer-unlock-label = Unlock layers
db-cmd-layer-unlock-description = Unlocks the layers of the chosen objects, in one undoable step.
db-cmd-property-change-label = Change properties
db-cmd-property-change-description = Changes the layer and the appearance properties of the chosen objects, in one undoable step.
db-cmd-property-match-label = Match properties
db-cmd-property-match-description = Copies the layer and appearance properties of a source object to the chosen objects, in one undoable step.
db-cmd-name-taken = Another layer already has that name; names are compared without regard to case.
db-cmd-layer-special = Layer 0 and the definition-point layer cannot be renamed, deleted or merged away.
db-cmd-layer-in-use = The layer holds objects; use the delete-with-contents command to remove them with it.
db-cmd-layer-rename-label = Rename layer
db-cmd-layer-rename-description = Renames a layer, refusing layer 0, the definition-point layer and names already in use, in one undoable step.
db-cmd-layer-delete-label = Delete unused layers
db-cmd-layer-delete-description = Deletes layers that hold no objects, in one undoable step.
db-cmd-layer-delete-with-contents-label = Delete layers with contents
db-cmd-layer-delete-with-contents-description = Deletes layers and every object on them, including objects inside block definitions, in one undoable step.
db-cmd-layer-merge-label = Merge layers
db-cmd-layer-merge-description = Moves the objects of source layers, including objects inside block definitions, to a target layer and removes the source layers, in one undoable step.
